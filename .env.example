# Unipile credentials for LinkedIn deep discovery.
# The same key can be shared with the reach-sales-outreach engine.
UNIPILE_API_KEY=
# Optional; defaults to api.unipile.com.
UNIPILE_DSN=
# Optional; when absent the script picks the first unlocked LinkedIn account.
UNIPILE_LINKEDIN_ACCOUNT_ID=
# Optional request timeout in ms; default 30000, 0 disables.
# Raise to 60000+ if company-page fetches time out — that route is slow
# and the client retries, but each attempt honors this timeout.
UNIPILE_TIMEOUT_MS=
